@baseUrl = https://localhost:7020

### List todos
GET {{baseUrl}}/api/todos

@todoId = d7ea2d05-9c79-444f-8413-08df06132d16

### Get a todo by ID
GET {{baseUrl}}/api/todos/{{todoId}}

### Create a todo
POST {{baseUrl}}/api/todos
Content-Type: application/json

{
  "title": "Buy groceries"
}

### Update a todo
PUT {{baseUrl}}/api/todos
Content-Type: application/json
Accept: application/json

{
  "id": "{{todoId}}",
  "title": "Buy groceries",
  "completed": true
}

### Delete a todo
DELETE {{baseUrl}}/api/todos/{{todoId}}
Accept: application/json



